# Offline/local development defaults. Replace only when enabling external services.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assessment_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/assessment_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Leave blank for the offline fixture test; live LLM calls require a real key.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_STRONG=openai/gpt-oss-120b
MODEL_CODE=qwen/qwen3.8-27b
MODEL_CHEAP=openai/gpt-oss-20b

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
JUDGE0_API_URL=
JUDGE0_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

API_SECRET_KEY=local-only-change-me
BCRYPT_ROUNDS=12
MAX_INTERNAL_RETRIES=3
MAX_EXTERNAL_RETRIES=3
MAX_REVISION_CYCLES=5
QUALITY_SCORE_THRESHOLD=4.0
FINAL_QA_PERCENT_THRESHOLD=70.0
QUALITY_PASS_THRESHOLD=4.0
DEDUP_REJECT_THRESHOLD=0.92
DEDUP_FLAG_THRESHOLD=0.80
SANDBOX_TIMEOUT_SECONDS=10
OFFLINE_MODE=true
